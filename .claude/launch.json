{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/web", "run", "dev"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "api",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd apps/api && set -a && . ../../.env && set +a && exec ../../.venv/bin/uvicorn cronsentinel.main:app --reload --host 127.0.0.1 --port 8000"],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "api-mock",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd apps/api && exec ../../.venv/bin/uvicorn --app-dir ../../tools/ui-review mock_api:app --host 127.0.0.1 --port 8000"],
      "port": 8000,
      "autoPort": false
    }
  ]
}

{
  "realm": "cronsentinel",
  "enabled": true,
  "registrationAllowed": true,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "clients": [
    {
      "clientId": "cronsentinel-web",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "change-me",
      "redirectUris": [
        "http://localhost:8000/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "identity provider",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "identity_provider",
            "claim.name": "idp",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "jobwatch-admin",
      "name": "JobWatch identity-provider admin (R43)",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {},
      "secret": "change-me-admin"
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabled": false,
      "config": {
        "clientId": "TODO",
        "clientSecret": "TODO"
      }
    },
    {
      "alias": "github",
      "providerId": "github",
      "enabled": false,
      "config": {
        "clientId": "TODO",
        "clientSecret": "TODO"
      }
    },
    {
      "alias": "microsoft",
      "providerId": "microsoft",
      "enabled": false,
      "config": {
        "clientId": "TODO",
        "clientSecret": "TODO"
      }
    }
  ],
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "enabled": true,
      "defaultAction": false
    }
  ],
  "users": [
    {
      "username": "service-account-jobwatch-admin",
      "enabled": true,
      "serviceAccountClientId": "jobwatch-admin",
      "clientRoles": {
        "realm-management": [
          "manage-identity-providers",
          "view-identity-providers"
        ]
      }
    }
  ],
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true
}

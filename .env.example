DATABASE_URL=postgresql+psycopg://cronsentinel:cronsentinel@localhost:5432/cronsentinel
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
KEYCLOAK_ISSUER=http://localhost:8080/realms/cronsentinel
KEYCLOAK_AUDIENCE=cronsentinel-web
# REQUIRED: openssl rand -base64 48   (empty/placeholder/<32 chars is refused at startup)
SECRET_ENCRYPTION_KEY=
INGEST_RATE_PER_MIN=600
API_RATE_PER_MIN=1200
RECONCILER_INTERVAL_S=30
LOG_LEVEL=INFO
KEYCLOAK_CLIENT_ID=cronsentinel-web
KEYCLOAK_CLIENT_SECRET=
# R43: printed by deploy/keycloak/import.sh; enables per-organization single sign-on
KEYCLOAK_ADMIN_CLIENT_SECRET=
API_PUBLIC_URL=http://localhost:8000
WEB_PUBLIC_URL=http://localhost:3000
COOKIE_SECURE=false
COPILOT_PROVIDER=openai
COPILOT_BASE_URL=http://ollama:11434
COPILOT_MODEL=qwen2.5:14b
COPILOT_API_KEY=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# R62: serve the Linux agent installer at <ingest>/agent/install.sh. Binaries are fetched from
# <AGENT_DOWNLOAD_BASE>/<AGENT_VERSION>/ and verified against SHA256SUMS. Empty = installer not served.
AGENT_DOWNLOAD_BASE=
AGENT_VERSION=
